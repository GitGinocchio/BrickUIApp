{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brick UI",
  "version": "0.1.0",
  "identifier": "BrickUI",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Brick UI [Settings]",
        "url" : "index.html",
        "width": 1000,
        "height": 800,
        "center" : true,
        "resizable": true,
        "alwaysOnTop": false,
        "fullscreen": false,
        "devtools": true,
        "focus" : true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Brick UI [Overlay]",
        "url" : "/overlay/index.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "titleBarStyle": "Transparent",
        "maximized": true,
        "hiddenTitle": true,
        "theme" : "Dark",
        "devtools": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "focus" : true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "headers" : {
        "Access-Control-Allow-Headers" : "Access-Control-Allow-Origin: *"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
