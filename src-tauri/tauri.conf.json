{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brick UI",
  "version": "0.1.0",
  "identifier": "BrickUI",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brick UI",
        "url" : "index.html",
        "width": 1000,
        "height": 800,
        "center" : true,
        "resizable": true,
        "alwaysOnTop": false,
        "fullscreen": false,
        "devtools": true,
        "focus" : true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Brick UI [Overlay]",
        "url" : "/overlay/index.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "titleBarStyle": "Transparent",
        "maximized": false,
        "fullscreen": false,
        "width": 0,
        "height": 0,
        "hiddenTitle": true,
        "theme" : "Dark",
        "devtools": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "focus" : true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../src/isolation"
        }
      },
      "csp": {
        "default-src": [
          "'self'",
          "asset:",
          "data:",
          "blob:",
          "http://asset.localhost",
          "tauri:",
          "http://tauri.localhost"
        ],
        "script-src": [
          "'unsafe-eval'",
          "'self'",
          "blob:",
          "asset:",
          "tauri:",
          "https:",
          "http://tauri.localhost",
          "http://asset.localhost",
          "'sha256-ZskXiwVb6eFg98EBh2Y8oS7d0faFNFrpupvtCfmc+JE='",
          "'sha256-/Tv0N/CR9ZPt68YXATQb2aV4UQcX/pD04ToiAKP+HMQ='"
        ],
        "connect-src": [
          "'self'",
          "ws:",
          "http://asset.localhost",
          "http://ipc.localhost",
          "tauri:",
          "http://tauri.localhost"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "asset:"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "data:",
          "blob:",
          "https:",
          "http://asset.localhost",
          "tauri:",
          "http://tauri.localhost"
        ],
        "media-src": [
          "'self'",
          "asset:",
          "data:",
          "blob:",
          "https:",
          "http://asset.localhost",
          "tauri:",
          "http://tauri.localhost"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ]
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi","nsis"],
    "resources" : [
      "./assets"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
