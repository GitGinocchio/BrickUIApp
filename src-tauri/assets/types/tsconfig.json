{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "typeRoots": ["./.types"],
    "composite" : true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths" : {
      "core": ["./.types/core"],
      "vue" : ["./.types/vue"],
      "event" : ["./.types/event"]
    }
  },
  "include": [
    "./.types/**/*.js",
    "./.types/**/*.ts", 
    "./.types/**/*.tsx",
    "./.types/**/*.d.ts",
    "./**/*.d.ts",
    "./**/*.vue"
  ]
}
