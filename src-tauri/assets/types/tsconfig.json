{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "typeRoots": ["./.types", ".", "./node_modules/@types"],
    "composite" : true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "./.types/**/*.js",
    "./.types/**/*.ts", 
    "./.types/**/*.tsx",
    "./.types/**/*.d.ts",
    "./**/*.d.ts",
    "./**/*.vue"
  ]
}
