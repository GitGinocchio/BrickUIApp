{
  "name": "brickui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "flame": "cd src-tauri && cargo run --features profiling --bin brickui && npm run flamegraph",
    "dev:flame": "npm-run-all -p dev flame",
    "flamegraph": "inferno-flamegraph ./src-tauri/trace.folded > ./src-tauri/flamegraph.svg"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.2",
    "@nuxt/ui": "^4.6.1",
    "@nuxtjs/i18n": "^10.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.1",
    "naive-ui": "^2.42.0",
    "ogl": "^1.0.11",
    "sortablejs": "^1.15.7",
    "sortablejs-vue3": "^1.3.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vue3-sfc-loader": "^0.9.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/babel__standalone": "^7.1.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.6",
    "nuxt": "^4.4.2",
    "typescript": "6.0.3"
  }
}
