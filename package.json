{
  "name": "brickui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "cargo run --bin typegen && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "flame": "cd src-tauri && cargo run --features profiling --bin brickui && npm run flamegraph",
    "dev:flame": "npm-run-all -p dev flame",
    "flamegraph": "inferno-flamegraph ./src-tauri/trace.folded > ./src-tauri/flamegraph.svg"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "@lucide/vue": "^1.31.0",
    "@nuxt/ui": "^4.6.1",
    "@nuxtjs/i18n": "^10.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.3",
    "ogl": "^1.0.11",
    "sortablejs": "^1.15.7",
    "sortablejs-vue3": "^1.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6",
    "vue3-sfc-loader": "^0.9.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "nuxt": "^4.5.2",
    "@types/babel__standalone": "^7.1.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "7.0.2"
  }
}
